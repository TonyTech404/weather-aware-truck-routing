{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "routeguard-api",
	"main": "src/entry.py",
	"compatibility_date": "2026-07-29",
	"compatibility_flags": ["python_workers"],
	"observability": { "enabled": true },
	"routes": [{ "pattern": "routeguard-api.buildwithanthony.com", "custom_domain": true }],
	"vars": {
		"DJANGO_ALLOWED_HOSTS": "routeguard-api.buildwithanthony.com",
		"CORS_ALLOWED_ORIGINS": "https://routeguard.buildwithanthony.com"
	}
}
