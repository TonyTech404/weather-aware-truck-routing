# --- Backend (backend/.env or Cloudflare secrets/vars) ---
# Required in production: set as a Cloudflare secret (`pywrangler secret put DJANGO_SECRET_KEY`).
DJANGO_SECRET_KEY=change-me
# 1 only for local development.
DJANGO_DEBUG=1
# Comma-separated list of allowed Host headers.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (frontend/.env.local) ---
# Base URL of the Django API. Leave empty in dev to use the Vite proxy.
VITE_API_BASE_URL=
