{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "routeguard-web",
	"compatibility_date": "2026-07-29",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"routes": [
		{ "pattern": "routeguard.buildwithanthony.com", "custom_domain": true },
		{ "pattern": "www.routeguard.buildwithanthony.com", "custom_domain": true }
	],
	"observability": { "enabled": true }
}
